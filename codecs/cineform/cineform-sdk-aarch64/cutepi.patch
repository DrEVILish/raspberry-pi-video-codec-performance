 // Routines for the worker threads that use the new threads API
 
+// CuTePi: RGBA to an 8-bit format with alpha went through a 16-bit copy of the whole frame (RGBFilterBuffer16),
+// written by the inverse transform and read back by a second pass (Row16uFull2OutputFormat). At 1080p that is
+// 16 MB written to memory and read again per frame, and memory traffic is what limits several decoders side by
+// side. With one worker thread, the rows are now converted as soon as the transform has written them, through
+// the first two rows of that buffer, which stay in the cache. Same calls per row, in the same order of rows as
+// the second pass made them, so the output is the same.
+static void CutepiRowsToOutput(DECODER *decoder, FRAME_INFO *info, int thread_index, int y, int count, int src_row)
+{
+	uint16_t *scanline = (uint16_t *)decoder->threads_buffer[thread_index];
+	int i;
+	for (i = 0; i < count && y + i < info->height; i++)
+	{
+		ConvertPlanarGRBAToPlanarRGBA((PIXEL *)scanline,
+			(PIXEL *)(decoder->RGBFilterBuffer16 + info->width * 4 * (src_row + i)), info->width);
+		Convert4444LinesToOutput(decoder, info->width, 1, y + i, scanline,
+			decoder->cutepi_rows_output + decoder->cutepi_rows_pitch * (y + i), decoder->cutepi_rows_pitch,
+			info->format, 16, ACTIVEMETADATA_PRESATURATED|ACTIVEMETADATA_PLANAR);
+	}
+}
